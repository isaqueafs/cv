---
import Icon from './Icon.astro'

interface Props {
    lang: 'pt-BR' | 'en'
}

const { lang } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const isPt = lang === 'pt-BR'

const t = isPt
    ? { nav: 'Idioma', toLight: 'Ativar tema claro', toDark: 'Ativar tema escuro' }
    : { nav: 'Language', toLight: 'Switch to light theme', toDark: 'Switch to dark theme' }

const current = 'text-text inline-flex items-center pointer-coarse:min-h-11 pointer-coarse:px-2'
const other = 'hover:text-text transition-colors duration-150 inline-flex items-center pointer-coarse:min-h-11 pointer-coarse:px-2'
---

<div class="flex items-center gap-3 pt-1 shrink-0">
    <nav aria-label={t.nav} class="text-meta font-mono text-muted flex items-center gap-1">
        <a href={`${base}/`} hreflang="pt-BR" lang="pt-BR"
           aria-current={isPt ? 'page' : undefined}
           class={isPt ? current : other}>pt-br</a>
        <span aria-hidden="true">/</span>
        <a href={`${base}/en/`} hreflang="en" lang="en"
           aria-current={isPt ? undefined : 'page'}
           class={isPt ? other : current}>en-us</a>
    </nav>
    <button
        id="theme-toggle"
        type="button"
        hidden
        data-label-light={t.toLight}
        data-label-dark={t.toDark}
        class="inline-flex items-center justify-center text-muted hover:text-text text-meta font-mono border border-border rounded px-2 py-1 hover:border-accent/40 transition-colors duration-150 pointer-coarse:size-11">
        <span data-theme-icon="dark"><Icon name="sun" /></span>
        <span data-theme-icon="light"><Icon name="moon" /></span>
    </button>
</div>

<script>
    const btn = document.getElementById('theme-toggle') as HTMLButtonElement
    const root = document.documentElement

    function getTheme() {
        return root.getAttribute('data-theme') === 'light' ? 'light' : 'dark'
    }

    // O ícone mostra o tema de destino; o rótulo nomeia a ação.
    function render() {
        const theme = getTheme()
        btn.querySelectorAll<HTMLElement>('[data-theme-icon]').forEach(el => {
            el.hidden = el.dataset.themeIcon !== theme
        })
        btn.setAttribute('aria-label', theme === 'dark' ? btn.dataset.labelLight! : btn.dataset.labelDark!)
    }

    btn.addEventListener('click', () => {
        const next = getTheme() === 'dark' ? 'light' : 'dark'
        root.setAttribute('data-theme', next)
        root.classList.add('theme-ready')
        document.cookie = `theme=${next};path=/;max-age=31536000;SameSite=Lax`
        render()
    })

    render()
    btn.hidden = false
</script>
