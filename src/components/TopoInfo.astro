---
import Icon from './Icon.astro'

interface Props {
    // 'auto': renderiza PT e EN e deixa o CSS escolher pelo <html lang> (usado no 404 bilíngue)
    lang: 'pt-BR' | 'en' | 'auto'
}

const { lang } = Astro.props

const dict = {
    'pt-BR': {
        triggerLabel: 'Sobre o fundo topográfico',
        title: 'sobre o fundo',
        close: 'Fechar',
        inspirationLabel: 'inspiração',
        inspiration: 'As curvas de nível são inspiradas em mapas topográficos.',
        buildLabel: 'montagem',
        build: 'Tudo é gerado no seu navegador: ruído Perlin com distorção vira um relevo, o algoritmo marching squares traça as curvas de nível e a suavização de Chaikin arredonda as linhas.',
        uniqueLabel: 'só seu',
        unique: 'Cada visita sorteia uma semente entre 4,3 bilhões, então este relevo dificilmente vai se repetir. O código dele é',
        redraw: 'gerar outro relevo',
    },
    en: {
        triggerLabel: 'About the topographic background',
        title: 'about the background',
        close: 'Close',
        inspirationLabel: 'inspiration',
        inspiration: 'The contour lines are inspired by topographic maps.',
        buildLabel: 'how it’s made',
        build: 'Everything is generated in your browser: warped Perlin noise becomes terrain, the marching squares algorithm traces the contour lines and Chaikin smoothing rounds them off.',
        uniqueLabel: 'yours only',
        unique: 'Every visit draws one seed out of 4.3 billion, so this terrain is unlikely to ever repeat. Its code is',
        redraw: 'generate another terrain',
    },
} as const

type Key = keyof (typeof dict)['en']
const langs = lang === 'auto' ? (['pt-BR', 'en'] as const) : ([lang] as const)
const primary = dict[langs[0]]
// Em modo auto, cada texto vira uma variante por idioma; senão, só o texto
const variants = (key: Key) => langs.map(l => ({ l, text: dict[l][key], attr: lang === 'auto' ? l : undefined }))
---

<button
    type="button"
    id="topo-info-trigger"
    popovertarget="topo-info"
    aria-label={primary.triggerLabel}
    title={primary.triggerLabel}
    data-label-pt={dict['pt-BR'].triggerLabel}
    data-label-en={dict.en.triggerLabel}
    data-auto-lang={lang === 'auto' ? '' : undefined}
    hidden
    class="topo-info-trigger fixed z-10 inline-flex items-center justify-center size-11 rounded-full bg-surface border border-border text-accent text-lg hover:border-accent/40 hover:bg-surface-raised transition-colors duration-150">
    <Icon name="mountain" />
</button>

<div id="topo-info" popover class="topo-info" role="dialog" aria-labelledby="topo-info-title">
    <div class="flex items-start justify-between gap-4 mb-4">
        <h2 id="topo-info-title" class="text-meta text-accent uppercase tracking-widest">
            <span aria-hidden="true">&gt; </span>{variants('title').map(v => <span data-lang-variant={v.attr}>{v.text}</span>)}
        </h2>
        <button type="button" popovertarget="topo-info" popovertargetaction="hide" aria-label={primary.close} autofocus
                data-label-pt={dict['pt-BR'].close} data-label-en={dict.en.close}
                class="-m-1.5 p-1.5 text-muted hover:text-text transition-colors duration-150 pointer-coarse:-m-3 pointer-coarse:p-3">
            <Icon name="x" />
        </button>
    </div>

    <dl class="space-y-3">
        {(['inspiration', 'build'] as const).map(key => (
            <div>
                <dt class="text-meta text-muted font-mono">
                    {variants(`${key}Label`).map(v => <span data-lang-variant={v.attr}>{v.text}</span>)}
                </dt>
                <dd class="text-sm text-soft leading-relaxed">
                    {variants(key).map(v => <span data-lang-variant={v.attr}>{v.text}</span>)}
                </dd>
            </div>
        ))}
        <div>
            <dt class="text-meta text-muted font-mono">
                {variants('uniqueLabel').map(v => <span data-lang-variant={v.attr}>{v.text}</span>)}
            </dt>
            <dd class="text-sm text-soft leading-relaxed">
                {variants('unique').map(v => <span data-lang-variant={v.attr}>{v.text}</span>)}
                <span class="text-accent font-medium" data-topo-code>#········</span>.
            </dd>
        </div>
    </dl>

    <button type="button" data-topo-redraw
            class="mt-5 inline-flex items-center gap-2 text-meta font-mono text-text border border-border rounded px-3 py-1.5 hover:border-accent/40 hover:text-accent transition-colors duration-150 pointer-coarse:min-h-11">
        <Icon name="refresh" class="text-accent" />
        {variants('redraw').map(v => <span data-lang-variant={v.attr}>{v.text}</span>)}
    </button>
</div>

<script>
    const trigger = document.getElementById('topo-info-trigger')

    // Modo auto (404): rótulos acessíveis seguem o idioma que a página escolheu
    if (trigger?.hasAttribute('data-auto-lang')) {
        const isEn = document.documentElement.lang === 'en'
        document.querySelectorAll<HTMLElement>('#topo-info-trigger, #topo-info [data-label-pt]').forEach(el => {
            const label = isEn ? el.dataset.labelEn! : el.dataset.labelPt!
            el.setAttribute('aria-label', label)
            if (el === trigger) el.title = label
        })
    }

    function showCode(code: string) {
        document.querySelectorAll('[data-topo-code]').forEach(el => { el.textContent = `#${code}` })
        if (trigger) trigger.hidden = false
    }

    // O fundo pode ter sido desenhado antes deste script rodar; sem JavaScript o botão nunca aparece
    const current = document.documentElement.dataset.topoSeed
    if (current) showCode(current)
    window.addEventListener('topo:drawn', e => showCode((e as CustomEvent<{ code: string }>).detail.code))

    document.querySelector('[data-topo-redraw]')?.addEventListener('click', () => {
        window.dispatchEvent(new Event('topo:redraw'))
    })

    // Ancora o popover no botão: acima dele (ou abaixo, sem espaço), sempre dentro da tela
    const pop = document.getElementById('topo-info')!
    function place() {
        if (!trigger || !pop.matches(':popover-open')) return
        const r = trigger.getBoundingClientRect()
        const gap = 8, margin = 16
        const { offsetWidth: w, offsetHeight: h } = pop
        const left = Math.min(Math.max(r.right - w, margin), innerWidth - w - margin)
        const top = r.top - h - gap >= margin ? r.top - h - gap : Math.min(r.bottom + gap, innerHeight - h - margin)
        pop.style.left = `${left}px`
        pop.style.top = `${Math.max(top, margin)}px`
    }
    pop.addEventListener('toggle', e => {
        const open = (e as ToggleEvent).newState === 'open'
        // Com o popover aberto, o conteúdo esmaece e o fundo ganha destaque (ver .topo-focus no CSS)
        document.documentElement.classList.toggle('topo-focus', open)
        if (open) place()
    })
    window.addEventListener('resize', place)
</script>
