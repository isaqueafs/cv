---
import '../styles/global.css'

interface Props {
    title?: string
    description?: string
    lang?: string
}

const {
    title = 'Isaque Santos | dev web',
    description = 'Desenvolvedor web com 5+ anos de experiência, especializado em backend com PHP e Laravel.',
    lang = 'pt-BR',
} = Astro.props

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
        <link rel="icon" href={`${base}/favicon.ico`} />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />
        <link rel="alternate" hreflang="pt-BR" href={new URL(`${base}/`, Astro.site)} />
        <link rel="alternate" hreflang="en" href={new URL(`${base}/en/`, Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(`${base}/`, Astro.site)} />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:locale" content={lang === 'pt-BR' ? 'pt_BR' : 'en_US'} />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Mono:wght@400;500&display=swap"
            rel="stylesheet"
        />

        <!-- Spotlight nos cards: só o card sob o cursor, uma escrita por frame, só em mouse -->
        <script is:inline>
            if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
                var pending = null
                document.addEventListener('pointermove', function (e) {
                    var card = e.target.closest && e.target.closest('.card-glow')
                    if (!card) return
                    if (!pending) requestAnimationFrame(function () {
                        var rect = pending.card.getBoundingClientRect()
                        pending.card.style.setProperty('--mouse-x', (pending.x - rect.left) + 'px')
                        pending.card.style.setProperty('--mouse-y', (pending.y - rect.top) + 'px')
                        pending = null
                    })
                    pending = { card: card, x: e.clientX, y: e.clientY }
                }, { passive: true })
            }
        </script>

        <!-- Anti-flash tema -->
        <script is:inline>
            ;(function () {
                var match = document.cookie.match(/(?:^|;\s*)theme=([^;]+)/)
                var theme = match ? match[1] : 'dark'
                document.documentElement.setAttribute('data-theme', theme)
            })()
        </script>
    </head>
    <body class="min-h-screen bg-canvas text-text antialiased">
        <slot />
    </body>
</html>
