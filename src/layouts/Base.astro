---
import '../styles/global.css'

interface Props {
    title?: string
    description?: string
    lang?: string
}

const {
    title = 'Isaque Santos | dev web',
    description = 'Desenvolvedor web com 5+ anos de experiência, especializado em backend com PHP e Laravel.',
    lang = 'pt-BR',
} = Astro.props

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const isEn = lang === 'en'
// Cartão de compartilhamento (LinkedIn é o principal canal de entrada), gerado em public/
const ogImage = new URL(`${base}/og-${isEn ? 'en' : 'pt'}.png`, Astro.site)
const ogImageAlt = isEn
    ? 'Isaque Santos, Backend Developer · PHP/Laravel.'
    : 'Isaque Santos, Desenvolvedor Backend · PHP/Laravel.'
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
        <link rel="icon" href={`${base}/favicon.ico`} />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />
        <link rel="alternate" hreflang="pt-BR" href={new URL(`${base}/`, Astro.site)} />
        <link rel="alternate" hreflang="en" href={new URL(`${base}/en/`, Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(`${base}/`, Astro.site)} />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:locale" content={isEn ? 'en_US' : 'pt_BR'} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogImageAlt} />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        <meta name="twitter:image:alt" content={ogImageAlt} />

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500&display=swap"
            rel="stylesheet"
        />

        <!-- Anti-flash tema -->
        <script is:inline>
            ;(function () {
                var match = document.cookie.match(/(?:^|;\s*)theme=([^;]+)/)
                var theme = match ? match[1] : 'dark'
                document.documentElement.setAttribute('data-theme', theme)
            })()
        </script>
    </head>
    <body class="min-h-screen bg-canvas text-text antialiased">
        <div class="topo-bg" aria-hidden="true"></div>
        <slot />

        <!-- Relevo novo a cada carregamento, na proporção da tela -->
        <script>
            import { topographyPath } from '../lib/topography'

            const layer = document.querySelector<HTMLElement>('.topo-bg')

            function draw() {
                if (!layer) return
                // Lado maior fixo em 1600: o custo não cresce em telas altas de celular
                const ratio = innerWidth / innerHeight
                const width = Math.round(ratio >= 1 ? 1600 : 1600 * ratio)
                const height = Math.round(ratio >= 1 ? 1600 / ratio : 1600)
                const seed = crypto.getRandomValues(new Uint32Array(1))[0]
                layer.innerHTML = `<svg viewBox="0 0 ${width} ${height}" preserveAspectRatio="xMidYMid slice"><path d="${topographyPath({ width, height, seed })}"/></svg>`
                requestAnimationFrame(() => layer.classList.add('is-ready'))

                // Publica a semente (o "código" deste relevo) para o TopoInfo
                const code = seed.toString(16).toUpperCase().padStart(8, '0')
                document.documentElement.dataset.topoSeed = code
                window.dispatchEvent(new CustomEvent('topo:drawn', { detail: { code } }))
            }

            window.addEventListener('topo:redraw', draw)

            // Fora do caminho crítico: desenha depois da primeira pintura, quando o navegador estiver ocioso
            if ('requestIdleCallback' in window) requestIdleCallback(draw, { timeout: 1500 })
            else setTimeout(draw, 200)
        </script>
    </body>
</html>
