---
import Base from "../layouts/Base.astro";
import HeaderControls from "../components/HeaderControls.astro";
import Icon from "../components/Icon.astro";
import ContactLinks from "../components/ContactLinks.astro";

const year = new Date().getFullYear()

const experience = [
    {
        role: 'Analista de Desenvolvimento / Dev Principal',
        period: '2021 – atual',
        items: [
            ['LMS corporativo', 'responsável por mais de 95% da base de código e dos commits durante 3 anos na construção de uma plataforma LMS/Universidade Corporativa em Laravel/PHP para treinamento de colaboradores e franqueados de rede educacional multi-marca.'],
            ['Arquitetura multi-tenant & controle de acesso', 'projetei e implementei arquitetura multi-tenant para múltiplas marcas/franquias, com RBAC hierárquico (Usuário, Admin, Super Admin).'],
            ['Desenvolvimento assistido por IA', 'implantei IA generativa no ciclo de vida de software: Skills customizadas, servidores e ferramentas via MCP, acelerando testes, refatoração e documentação técnica.'],
            ['Pipeline de mídia & streaming', 'implementei o pipeline completo de vídeos educacionais (upload, streaming e tracking de progresso), liderando a migração de provedor e a rotina de backup automatizado no AWS S3.'],
            ['ERP multi-marca', 'responsável desde a implantação pelo desenvolvimento e evolução do portal multi-marca (6 redes de franquia) que integra 9 bancos de dados e sistemas externos (ERP TOTVS, WhatsApp Cloud API), em PHP 8/Twig, com autoria de ~70% dos commits ao longo de quase 3 anos de operação contínua.'],
            ['Integrações & legado', 'liderei a reestruturação de projetos legados e integrei autenticação externa (SSO) entre marcas e ecossistemas legados.'],
        ],
    },
    {
        role: 'Auxiliar de Desenvolvimento / Atendente Técnico',
        period: '2020 – 2022',
        items: [
            [null, 'Desenvolvi rotinas e aplicações próprias para automação e otimização de processos de suporte e configuração interna.'],
            [null, 'Prestei suporte remoto para resolução de incidentes em aplicações de produção e configuração remota de servidores Windows e Linux.'],
        ],
    },
]

const skills = [
    ['backend', ['PHP', 'Laravel', 'Go', 'Ruby', 'Ruby on Rails']],
    ['frontend', ['JavaScript (jQuery)', 'Sass', 'Bootstrap', 'Tailwind', 'Livewire', 'Vue']],
    ['banco de dados', ['MySQL', 'PostgreSQL']],
    ['infra & devops', ['AWS', 'Docker', 'Linux']],
    ['ia & automação', ['Claude Code', 'OpenAI Codex', 'MCP', 'Skills customizadas', 'Documentação assistida', 'Automação de workflows']],
    ['arquitetura & integrações', ['Multi-tenancy', 'SSO', 'PWA', 'REST APIs', 'Webhooks', 'Vimeo', 'Gumlet']],
] as const
---

<Base
    title="Isaque Santos | dev web"
    description="Desenvolvedor web com 5+ anos de experiência, especializado em backend com PHP e Laravel: LMS, ERP, plataformas multi-tenant e integrações AWS."
    lang="pt-BR">
    <main class="min-h-screen bg-canvas text-text">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16">
            <!-- Intro -->
            <header class="mb-10 lg:mb-14">
                <div class="flex items-start justify-between gap-4 mb-3">
                    <h1 class="font-display text-5xl sm:text-6xl text-accent tracking-wide leading-none">
                        Isaque Santos
                    </h1>
                    <HeaderControls lang="pt-BR" />
                </div>
                <p class="text-sm text-text/70 font-mono text-pretty">
                    Desenvolvedor Web · Engenheiro de Software Backend
                </p>
                <ContactLinks class="mt-5" />
            </header>

            <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_20rem] gap-4 lg:gap-6 items-start">
                <!-- Coluna principal -->
                <div class="space-y-4 lg:space-y-6 min-w-0">
                    <!-- Sobre -->
                    <div class="card-glow bg-surface border border-border rounded p-5 lg:p-6 transition-colors duration-200 hover:border-accent/30 hover:bg-surface-raised">
                        <h2 class="text-meta text-accent uppercase tracking-widest mb-3"><span aria-hidden="true">&gt; </span>sobre</h2>
                        <p class="text-body text-text">
                            Desenvolvedor Web com mais de 5 anos de experiência técnica,
                            especializado em backend com <span class="text-accent">PHP e Laravel</span>.
                            Forte atuação na arquitetura e evolução de ecossistemas complexos:
                            LMS, ERP, ATS, painéis administrativos e plataformas B2B/multi-tenant.
                            Experiência sólida em modernização de sistemas legados, integração com
                            serviços AWS, pipelines de vídeo/streaming e otimização de bancos
                            relacionais (MySQL/PostgreSQL). Experiência no uso de engenharia de
                            software assistida por IA (Claude Code, MCP, criação de Skills e automações).
                        </p>
                    </div>

                    <!-- Experiência -->
                    <div class="card-glow bg-surface border border-border rounded p-5 lg:p-6 transition-colors duration-200 hover:border-accent/30 hover:bg-surface-raised">
                        <h2 class="text-meta text-accent uppercase tracking-widest mb-4"><span aria-hidden="true">&gt; </span>experiência · MoveEdu</h2>
                        <div class="space-y-6">
                            {experience.map(job => (
                                <div class="border-l border-border pl-4">
                                    <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-x-4 gap-y-0.5 mb-2">
                                        <h3 class="text-body font-medium text-text">{job.role}</h3>
                                        <span class="text-meta text-muted font-mono shrink-0">{job.period}</span>
                                    </div>
                                    <ul class="space-y-1.5">
                                        {job.items.map(([label, text]) => (
                                            <li class="text-body text-soft">
                                                {label && <span class="text-text">{label}: </span>}{text}
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>

                <!-- Coluna lateral -->
                <aside aria-label="Detalhes do perfil" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-4 lg:gap-6 items-start">
                    <!-- Skills -->
                    <div class="card-glow bg-surface border border-border rounded p-5 lg:p-6 transition-colors duration-200 hover:border-accent/30 hover:bg-surface-raised sm:col-span-2 lg:col-span-1">
                        <h2 class="text-meta text-accent uppercase tracking-widest mb-5"><span aria-hidden="true">&gt; </span>skills</h2>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-5">
                            {skills.map(([group, items]) => (
                                <div>
                                    <p class="text-meta text-muted font-mono mb-2">{group}</p>
                                    <div class="flex flex-wrap gap-1.5">
                                        {items.map(s => (
                                            <span class="text-meta font-mono text-text bg-canvas border border-border rounded px-2 py-0.5">{s}</span>
                                        ))}
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>

                    <!-- Formação -->
                    <div class="card-glow bg-surface border border-border rounded p-5 lg:p-6 transition-colors duration-200 hover:border-accent/30 hover:bg-surface-raised">
                        <h2 class="text-meta text-accent uppercase tracking-widest mb-4"><span aria-hidden="true">&gt; </span>formação & certificações</h2>
                        <div class="space-y-3">
                            <div class="border-l border-border pl-4">
                                <div class="flex items-baseline justify-between gap-4">
                                    <span class="text-sm font-medium text-text">Senac</span>
                                    <span class="text-meta text-muted font-mono shrink-0">2020</span>
                                </div>
                                <p class="text-sm text-muted mt-0.5">Técnico em Informática</p>
                            </div>
                            <div class="border-l border-border pl-4">
                                <div class="flex items-baseline justify-between gap-4">
                                    <a href="https://cursos.alura.com.br/user/isaque-santos0/fullCertificate/2d3211521741cb72f0c2c6a8b673279d"
                                       target="_blank" rel="noopener noreferrer"
                                       class="inline-flex items-center gap-1 text-sm font-medium text-text hover:text-accent transition-colors duration-150">
                                        Alura <Icon name="external-link" class="text-xs" />
                                    </a>
                                    <span class="text-meta text-muted font-mono shrink-0">contínuo</span>
                                </div>
                                <p class="text-sm text-muted mt-0.5">Especialização em DevOps e tecnologias web</p>
                            </div>
                        </div>
                    </div>

                    <!-- Idiomas -->
                    <div class="card-glow bg-surface border border-border rounded p-5 lg:p-6 transition-colors duration-200 hover:border-accent/30 hover:bg-surface-raised">
                        <h2 class="text-meta text-accent uppercase tracking-widest mb-4"><span aria-hidden="true">&gt; </span>idiomas</h2>
                        <div class="space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="text-sm text-text">Português</span>
                                <span class="text-meta text-muted font-mono">Nativo</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-sm text-text">Inglês</span>
                                <span class="text-meta text-muted font-mono">Avançado · C1</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-sm text-text">Espanhol</span>
                                <span class="text-meta text-muted font-mono">Básico · A2</span>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>

            <footer class="mt-10 lg:mt-14 pt-5 border-t border-border flex items-center justify-between gap-x-6 gap-y-2 flex-wrap">
                <p class="text-meta text-muted font-mono">© {year} Isaque Santos</p>
                <ContactLinks />
            </footer>
        </div>
    </main>
</Base>

