---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import TopoInfo from '../components/TopoInfo.astro'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')

// O GitHub Pages serve um único 404.html para o site inteiro, então as duas
// versões ficam na mesma página e o script abaixo escolhe qual mostrar.
const versions = [
    {
        lang: 'pt-BR',
        title: 'PERDIDO?',
        text: 'Essa rota não existe. Mas quem sabe você estava procurando pelo dev que a construiu.',
        links: [
            { href: `${base}/`, icon: 'home', label: 'isaque santos · dev web' },
            { href: 'mailto:isaqueafsantos@gmail.com', icon: 'mail', label: 'isaqueafsantos@gmail.com' },
            { href: `${base}/en/`, icon: 'world', label: 'switch to english version', hreflang: 'en' },
        ],
    },
    {
        lang: 'en',
        title: 'LOST?',
        text: "This route doesn't exist. But maybe you were looking for the dev who built it.",
        links: [
            { href: `${base}/en/`, icon: 'home', label: 'isaque santos · web dev' },
            { href: 'mailto:isaqueafsantos@gmail.com', icon: 'mail', label: 'isaqueafsantos@gmail.com' },
            { href: `${base}/`, icon: 'world', label: 'ver versão em português', hreflang: 'pt-BR' },
        ],
    },
] as const
---

<Base title="404 — Isaque Santos" lang="pt-BR">
    <!-- Roda antes do conteúdo ser desenhado: sem flash do idioma errado -->
    <script is:inline define:vars={{ base }}>
        var path = location.pathname
        var browser = (navigator.languages && navigator.languages[0]) || navigator.language || ''
        // Rota sob /en/ manda; fora dela, vale o idioma do navegador (português → PT, resto → EN)
        var isEn = path.indexOf(base + '/en/') === 0 || !/^pt\b/i.test(browser)
        if (isEn) {
            document.documentElement.lang = 'en'
            document.title = '404 — Isaque Santos'
        }
    </script>

    <main class="h-screen flex items-center justify-center px-4">
        <div class="w-full max-w-md">
            {versions.map(v => (
                <div data-lang-variant={v.lang} lang={v.lang} class="bg-surface border border-accent/30 rounded p-8">

                    <p class="text-meta text-muted uppercase tracking-widest mb-6"> > 404 not found</p>

                    <h1 class="font-display text-7xl sm:text-8xl text-accent leading-none tracking-wide mb-1">
                        {v.title}
                    </h1>

                    <p class="text-body text-muted mb-6">{v.text}</p>

                    <div class="border-t border-border pt-5 space-y-2">
                        {v.links.map(link => (
                            <a href={link.href} hreflang={'hreflang' in link ? link.hreflang : undefined}
                               class="flex items-center gap-3 min-h-11 text-sm text-muted hover:text-text transition-colors duration-150">
                                <Icon name={link.icon} class="text-accent text-base w-4" />
                                <span>{link.label}</span>
                            </a>
                        ))}
                    </div>

                </div>
            ))}
            <TopoInfo lang="auto" />
        </div>
    </main>
</Base>
